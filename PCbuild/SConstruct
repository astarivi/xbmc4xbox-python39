import os
import hashlib

env = Environment(
    tools=['clang', 'mslink'],
    CC='clang',
    LINK='lld-link',
    AR='llvm-lib',
    SHLIBSUFFIX='.dll',
    LIBSUFFIX='.lib'
    # We don't inherit system ENV to avoid stdinc
)

INTERMEDIATE_DIR = 'objs'
env['ENV']['PATH'] = os.environ['PATH']

# Note: Only use forward slashes for paths, regardless of platform!!
# Set the path to LSDK here, or copy it from system env if it's declared there:
# env['LSDK'] = os.environ['LSDK']
env['LSDK'] = 'F:/LSDK'
env['ZLIB'] = '../../zlib-1.3.1'

# Nuke these to avoid flag injection from SCons.
env['SHCCFLAGS'] = []
env['CCFLAGS'] = []
env['CFLAGS'] = []
env['LINKFLAGS'] = []
env['CPPPATH'] = []
env['CXXPATH'] = []
env['LIBS'] = []
env['LIBPATH'] = []

# Clang flags.
env.Append(CFLAGS=[
    # Platform flags
    '-target', 'i386-pc-win32', # Always needed when targeting the Xbox
    '-march=pentium3',
    # Tell Clang what linker will we use later
    "-fuse-ld=lld-link",
    # Disable stdinc. These include the CRT on Windows, or glibc/musl on Linux
    '-nostdinc',
    '-nostdinc++',

    # Behavior flags
    '-Wall',
    '-Wno-unused-result',
    '-Wsign-compare',
    '-Wunreachable-code',
    '-Wno-missing-field-initializers',
    '-Werror=implicit-function-declaration',
    '-Wnonportable-include-path',
    '-fvisibility=hidden',

    # Runtime flags
    '-std=c99',
    '-fwrapv',
    '-fms-extensions',
    '-fmsc-version=1310',
    '-fms-runtime-lib=dll',

    # Optimization flags
    '-O3',
    # LTO will produce better performing binaries, but intermediate objects will be in LLVM bitcode
    '-flto',
    '-finline-functions'
])

# Base defines
env.Append(CPPDEFINES=[
    # MD
    '_DLL',
    '_USRDLL',

    # Platform
    '_WIN32',
    'WIN32',
    'MS_WINDOWS',
    '_XBOX',
    '_MAX_ENV=32767',

    # Python
    'NDEBUG',
    # We probably don't need this. Actually, we probably don't need to build most of the PC module at all.
    'PY3_DLLNAME="\\"python39.dll\\""',
    'MS_DLL_ID="\\"5.1\\""',
    'Py_BUILD_CORE',
    'Py_BUILD_CORE_BUILTIN',
    'Py_ENABLE_SHARED',
])

env.Append(CPPPATH=[
    # Source includes
    '../Xbox',
    '../Include',
    '../Include/internal',
    '../PC',
    '$ZLIB',

    # LSDK includes
    # With -nostdinc, we disabled intrinsics. Pull the clang include folder to enable them again.
    "E:/msys64/mingw64/lib/clang/20/include",
    # Include LSDK headers in the right order.
    "$LSDK/VC7/include",
    "$LSDK/VC7_PSDK/include",
    "$LSDK/W2003_PSDK/include",
#    "$LSDK/XDK/include"
])

env.Append(LINKFLAGS=[
    "-subsystem:windows",
    "-fixed",
    # Address call base for DLLs. Has to be 0x00010000 for XBEs!
    "-base:0x1E000000",
    "-merge:.edata=.edataxb",
    # Disable UCRT
    "/nodefaultlib",
    # Link with defaultlib MSVCRT
    "/defaultlib:msvcrt.lib"
])

env.Append(LIBS=[
    # Pull MSVCRT as high priority
    "msvcrt.lib",
    'kernel32.lib',
    'ws2_32.lib',
    'advapi32.lib',
    'psapi.lib',
    'version.lib',
    'oldnames.lib',
])

env.Append(LIBPATH=[
    # LSDK libs
    "$LSDK/VC7/lib",
    "$LSDK/VC7_PSDK/lib",
    "$LSDK/W2003_PSDK/lib",
#    "$LSDK/XDK/lib"
])

